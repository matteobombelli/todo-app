{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "composite": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "include": [
    "./**/*.ts",
    "../shared",
    "../worker",
    "../worker-configuration.d.ts"
  ],
  "exclude": [
    "./unit/client"
  ]
}
