{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite build && wrangler dev --local-upstream localhost:8787",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply todo-app --remote && wrangler deploy",
    "test": "vite build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "icons": "node scripts/generate-icons.mjs",
    "db:migrate:local": "wrangler d1 migrations apply todo-app --local",
    "db:migration": "wrangler d1 migrations create todo-app"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@fontsource-variable/figtree": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.24.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.136.3"
  }
}
